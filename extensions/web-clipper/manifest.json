{
  "manifest_version": 3,
  "name": "Noesis Web Clipper",
  "version": "1.0.0",
  "description": "Save the current page, or the selected part of it, to Noesis on this computer.",
  "action": { "default_popup": "popup.html", "default_title": "Save to Noesis", "default_icon": { "32": "icons/32.png", "128": "icons/128.png" } },
  "icons": { "32": "icons/32.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" } } },
  "browser_specific_settings": { "gecko": { "id": "web-clipper@noesis.app", "strict_min_version": "115.0" } }
}
